# ---- Postgres ----
POSTGRES_USER=erp
POSTGRES_PASSWORD=erp_password
POSTGRES_DB=erp_module
POSTGRES_PORT=5432

# ---- Backend ----
# Host/port the Express API binds to inside the container
BACKEND_PORT=4001
# Connection string used by the backend to reach Postgres.
# Host is the docker-compose service name "db" when running in compose.
DATABASE_URL=postgresql://erp:erp_password@db:5432/erp_module
# Origin allowed by CORS (the frontend dev server)
CORS_ORIGIN=http://localhost:3000

# ---- Digit ERP API (GraphQL) ----
# SERVER-SIDE ONLY. The token must never reach the browser — the frontend talks
# to this backend, which proxies to Digit. Demo tokens start with "da_".
DIGIT_API_URL=https://api.digit-software.com/graphql
DIGIT_API_TOKEN=

# ---- Cutting feature ----
# Digit operation name for the routing step this module's queue watches.
CUTTING_STEP_NAME=Cut to Size
# Default bin for side remnants (changeable per-cut in the UI).
REMNANT_BIN_NAME=Remnant Storage
# Digit's own frontend, for the "open serialized inventory list to reprint a
# label" link — there is no per-record deep link, only this fixed list URL
# plus a "Reprint label" button in Digit's own UI. See SCHEMA_NOTES.md.
DIGIT_APP_BASE_URL=https://app.digit-software.com

# ---- Frontend ----
FRONTEND_PORT=3000
# Base URL the browser uses to reach the backend API.
# Must be reachable from the host, not from inside the compose network.
VITE_API_URL=http://localhost:4001
